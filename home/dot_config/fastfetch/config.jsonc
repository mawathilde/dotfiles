{
  // Fastfetch JSON config with comments
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // ⬇️ Logo settings with padding
  "logo": {
    "source": "~/.config/fastfetch/minimiku.png",
    "padding": {
      "top": 2,
      "right": 2,
      "left": 5
    }
  },

  "display": {
    "separator": " : "
  },

  "modules": [
    // ──[ Hyprland splash info ]─────────────────────────────────────

    // ┌─[ System Info Section ]──────────────────────────────────────
    {
      "type": "custom",
      "format": "┌────[  System Overview ]────────────────────────────┐"
    },
    {
      "type": "host",
      "key": "  󰇺 Host",
      "format": "{2} {3}"
    },
    {
      "type": "os",
      "key": "  󰣇 OS",
      "format": "{2}",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "   Kernel",
      "format": "{2}",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": "  󰏗 Packages",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": "   Shell",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "  󰍹 Display",
      "format": "{1}x{2} @ {3}Hz [{7}]",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": "   Terminal",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "  󱗃 WM",
      "format": "{2}",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "└─────────────────────────────────────────────────────┘"
    },

    "break",

    // ┌─[ User Info Section ]───────────────────────────────────────
    {
      "type": "title",
      "key": "  ",
      "format": "{6} {7} {8}" // username@hostname
    },

    {
      "type": "custom",
      "format": "┌────[ 󰀄 Hardware & Performance ]────────────────────┐"
    },
    {
      "type": "cpu",
      "format": "{1} @ {7}",
      "key": "   CPU",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "format": "{1} {2}",
      "key": "  󰊴 GPU",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "format": "{3}",
      "key": "   GPU Driver",
      "keyColor": "magenta"
    },
    {
      "type": "memory",
      "key": "  󱤩 Memory",
      "keyColor": "magenta"
    },
    {
      "type": "command",
      "key": "  󰔏 Temp",
      "keyColor": "red",
      "text": "sensors | grep 'Package id 0' | awk '{print $4}'"
    },
    {
      "type": "battery",
      "key": "  󰂄 Battery",
      "keyColor": "yellow"
    },
    {
      "type": "disk",
      "key": "  󱦟 OS Age",
      "folders": "/",
      "keyColor": "red",
      "format": "{days} days"
    },
    {
      "type": "uptime",
      "key": "  󱫐 Uptime",
      "keyColor": "red"
    },
    {
      "type": "localip",
      "key": "  󰍧 Local IP",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "└─────────────────────────────────────────────────────┘"
    },

    "break",

    // ┌─[ Color Scheme Preview ]───────────────────────────────────
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
